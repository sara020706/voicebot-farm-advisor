# VoiceBot Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT Secret Key
# Use any random string with at least 32 characters
# Example: my-super-secret-jwt-key-for-voicebot-app-2024
SECRET_KEY=

# OpenWeatherMap API Key (Optional)
# Get from: https://openweathermap.org/api
# Leave empty if you don't need weather features yet
WEATHER_API_KEY=

# Ollama Configuration (Local LLM)
# Base URL for Ollama API (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Model to use (default: mistral, alternatives: llama3)
OLLAMA_MODEL=mistral

# Google Gemini API Key (for Voice Assistant)
# Get from: https://aistudio.google.com/app/apikey


# Debug Mode
DEBUG=true
